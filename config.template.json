{
  // file-agent 설정 템플릿.
  // config.json 이 없을 때 file-agent-ui.exe / file-agent.exe 가 이 파일을 복사해 config.json 을 만든다.
  // 값은 file-agent-ui.exe 로 바꾸는 것을 권장한다 (메모장으로 고칠 때는 UTF-8, BOM 없음으로 저장).
  // 업그레이드할 때 zip 을 같은 폴더에 풀어도 운영 중인 config.json 은 덮이지 않는다.

  // ── 1. 모드 ─────────────────────────────────────────────
  // "backend" = TERESA MQ 백엔드 경유 (권장) | "direct" = S3 직접 업로드
  "mode": "backend",

  // ── 2. 감시 폴더 · 이 PC ────────────────────────────────
  // backend 모드에서는 캔버스 노드의 WatchDir 가 우선이다. 여기 목록은 백엔드에 붙기 전의 임시값.
  // 로컬 디스크 경로를 쓸 것 — 부팅 시 SYSTEM 계정으로 돌기 때문에 매핑 드라이브(Z: 등)는 보이지 않는다.
  "watch_dirs": [],
  // 백엔드 노드의 Token 과 같은 값. UI 「연결」 탭의 [새 토큰 생성] 으로 만든다.
  // 이 기본값 그대로는 데몬이 시작하지 않는다.
  "token": "change-me-please-long-random-token",
  // 이 에이전트가 이 PC 에서 여는 포트 (백엔드 포트가 아님).
  "port": 8765,

  // ── 3. 전송 성능 ────────────────────────────────────────
  "ws_senders": 48,          // 백엔드와 동시에 여는 WS 연결 수
  "ws_send_timeout": 60,     // WS send 타임아웃(초) — 백엔드 정체 시 무한 대기 방지
  // 보내기 전에 '이미 적재된 파일인지' 묻는다. 끄면 원장(sent.jsonl)에 없는 파일을 전부 다시 보낸다.
  // 빈 버킷에 대량 초기적재를 할 때만 잠깐 false 로 둔다.
  "offer_enabled": true,

  // ── 4. 원장(sent.jsonl) ─────────────────────────────────
  "ledger_compaction": true,          // 디스크에서 지워진 파일의 기록을 주기적으로 정리
  "ledger_keep_in_memory": 5000000,   // 메모리에 둘 기록 수 상한 (항목당 약 350B)
  // 보정 스캔·원장 정리 주기(초). 새 파일은 실시간 감시로 바로 잡히고, 이 스캔은 놓친 것을 메우는 용도다.
  // 폴더가 크면 한 번 훑는 데 오래 걸리므로(10만 파일 ≈ 수십 분) 짧게 잡지 않는다.
  "rescan_interval_seconds": 3600,

  // ── 5. 동기화 ───────────────────────────────────────────
  // "speed" = 적재만 | "mirror" = 로컬 삭제도 백엔드에 알림 (캔버스 노드도 mirror 여야 실제로 지움)
  "sync_mode": "speed",

  // ── 6. 무손실 ───────────────────────────────────────────
  "ack_timeout_seconds": 3600,   // 적재 확인을 이만큼 못 받으면 다시 보낸다(초)

  // ── 7. 로그 ─────────────────────────────────────────────
  // "INFO" = 연결·설정 변경·경고 (권장) | "WARNING" = 경고·오류만 | "DEBUG" = 파일 단위까지
  "log_level": "INFO",
  "log_max_mb": 50,
  "log_backups": 10,

  // ── 8. backend 모드 ─────────────────────────────────────
  // 접속할 TERESA MQ 백엔드 주소 (예: http://서버IP:백엔드포트). 이 PC 의 주소가 아니다.
  "ws_url": "",

  // ── 9. direct 모드 (자격증명 포함 — 취급 주의) ──────────
  "s3_endpoint": "",
  "s3_bucket": "",
  "s3_access_key": "",
  "s3_secret_key": "",
  "s3_path_prefix": ""
}
